# Copy to .env (or export these) for local development.
# If DATABASE_URL is left unset, the app automatically uses a local
# SQLite file (immortalnet.db) - no Postgres install needed to try it out.

# DATABASE_URL=postgresql://user:password@localhost:5432/immortalnet
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1
